# Google Earth Engine Credentials
# Copy this file to .env and fill in your values

# Method 1: OAuth User-based (recommended for personal use)
# Run: python -c "import ee; ee.Authenticate()"
# Then: python -c "import ee; ee.Initialize()"
# No env vars needed - credentials stored in ~/.config/earthengine/

# Method 2: Service Account (for server/production)
# GEE_PROJECT_ID=your-cloud-project-id
# GEE_SERVICE_ACCOUNT=your-sa@project.iam.gserviceaccount.com
# GEE_CREDENTIALS_FILE=/path/to/service-account-key.json

# Optional: Default output directory
GEOSTUDIO_OUTPUT_DIR=./output

# Optional: Default study area (WKT or GeoJSON string)
# GEOSTUDIO_DEFAULT_AREA="POLYGON((107.5 -7.3, 107.5 -6.9, 107.9 -6.9, 107.9 -7.3, 107.5 -7.3))"

# Optional: Default CRS for output
GEOSTUDIO_DEFAULT_CRS=EPSG:4326
